package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

filegroup(
    name = "artifacts",
    srcs = [
        "//peios",
        "//peios-sys",
    ],
)

filegroup(
    name = "package-sources",
    srcs = glob(
        [
            "*",
            ".bazel*",
            ".gitignore",
            ".github/**",
            "docs/**",
        ],
        allow_empty = True,
        exclude = [
            "bazel-*",
            "docs/archive/**",
            "docs/learn/dist/**",
        ],
    ) + [
        "//build:sources",
        "//packages:sources",
        "//peios:sources",
        "//peios-sys:sources",
        "//tools:sources",
        "//vendor:sources",
    ],
)

alias(
    name = "packages",
    actual = "//packages:store",
)
