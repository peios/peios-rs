load("@rules_rust//rust:defs.bzl", "rust_binary")
load(":package.bzl", "package_store", "package_store_test", "source_package")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = ["**/__pycache__/**"],
    ),
)

rust_binary(
    name = "check-blobs",
    srcs = ["check_blobs.rs"],
    edition = "2024",
    deps = [
        "@ppk_crates//:anyhow",
        "@ppk_crates//:sha2",
        "@ppk_crates//:zstd",
    ],
)

source_package(
    name = "development",
    srcs = ["//:package-sources"],
)

package_store(
    name = "store",
    packages = [":development"],
)

package_store_test(
    name = "store-test",
    size = "small",
    srcs = [
        "assembly.py",
        "package.py",
    ],
    main = "test_store.py",
)
