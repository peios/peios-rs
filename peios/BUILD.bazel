load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")
load("//build:checks.bzl", "shared_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(
    name = "sources",
    srcs = glob(["**"]),
)

rust_library(
    name = "peios",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "peios",
    crate_root = "src/lib.rs",
    edition = "2021",
    version = "0.4.0",
    deps = [
        "//peios-sys",
        "@crates//:bitflags",
        "@crates//:libc",
    ],
)

rust_test(
    name = "unit-binary",
    crate = ":peios",
    tags = ["manual"],
)

shared_test(
    name = "unit-tests",
    binary = ":unit-binary",
    libraries = ["@peios_sdk//:library"],
)

rust_test(
    name = "smoke-binary",
    srcs = ["tests/smoke.rs"],
    edition = "2021",
    tags = ["manual"],
    deps = [
        ":peios",
        "//peios-sys",
        "@crates//:libc",
    ],
)

shared_test(
    name = "smoke-tests",
    binary = ":smoke-binary",
    libraries = ["@peios_sdk//:library"],
)

rust_doc_test(
    name = "doc-tests",
    crate = ":peios",
    rustdoc_flags = ["--test-args=token::Impersonation"],
)

rust_test(
    name = "event-snapshot-binary",
    srcs = ["tests/event_snapshot.rs"],
    edition = "2021",
    tags = ["manual"],
    deps = [":peios"],
)

shared_test(
    name = "event-snapshot-tests",
    binary = ":event-snapshot-binary",
    libraries = ["@peios_sdk//:library"],
)

rust_library(
    name = "uapi",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["uapi"],
    crate_name = "peios",
    crate_root = "src/lib.rs",
    edition = "2021",
    version = "0.4.0",
    deps = [
        "//peios-sys:uapi",
        "@crates//:bitflags",
        "@crates//:libc",
    ],
)

rust_test(
    name = "uapi-unit-binary",
    crate = ":uapi",
    tags = ["manual"],
)

shared_test(
    name = "uapi-unit-tests",
    binary = ":uapi-unit-binary",
    libraries = ["@peios_sdk//:library"],
)
